# ─── TMDB ───────────────────────────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha UMA das opções abaixo.
# As chamadas à TMDB rodam só no servidor, então a chave nunca chega ao browser.

# Opção recomendada hoje pela TMDB: token de leitura v4 (Bearer).
# themoviedb.org → Settings → API → "API Read Access Token"
TMDB_READ_ACCESS_TOKEN=

# Alternativa: chave v3 clássica (api_key). Use esta OU a de cima.
# TMDB_API_KEY=
